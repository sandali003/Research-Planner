PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:research123@127.0.0.1:5432/autosense_db
# true for hosted databases such as Supabase (use its Session pooler connection string)
DATABASE_SSL=false

# Auth
JWT_SECRET=12345678
JWT_EXPIRES_IN=12h

# Python ML service (ml-service/server.py)
ML_SERVICE_URL=http://127.0.0.1:8001
ML_TIMEOUT_MS=1500

# Hidden fault prediction & mitigation service (vehical-hidden-fault-and-mitigation/api.py)
HIDDEN_FAULT_URL=http://127.0.0.1:8002
HIDDEN_FAULT_TIMEOUT_MS=2000
# Component 3 deterioration service (Component3-Deterioration/app.py)
DETERIORATION_SERVICE_URL=http://127.0.0.1:8003

# Sensor conversion
# MPU6050 raw LSB per g (16384 for the default +-2g range)
ACCEL_LSB_PER_G=16384
# Battery voltage = ESP32 pin voltage * this ratio (set to your divider: R1+R2 / R2)
VOLTAGE_DIVIDER_RATIO=5

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
