PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/autosense_db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Python ML service (ml-service/server.py)
ML_SERVICE_URL=http://127.0.0.1:8001
ML_TIMEOUT_MS=1500

# Sensor conversion
# MPU6050 raw LSB per g (16384 for the default +-2g range)
ACCEL_LSB_PER_G=16384
# Battery voltage = ESP32 pin voltage * this ratio (set to your divider: R1+R2 / R2)
VOLTAGE_DIVIDER_RATIO=5

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
